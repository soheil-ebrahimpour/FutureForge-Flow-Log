{
  "manifest_version": 3,
  "name": "FutureForge Ai By Passer",
  "version": "1.0.0",
  "description": "نسخهٔ شخصی FutureForge برای دیدن درخواست‌های پیکربندی Google Flow.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://flow.google.com/*"],
  "action": {
    "default_title": "FutureForge Ai By Passer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["dist/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
